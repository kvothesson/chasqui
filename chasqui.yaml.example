api:
  key: ${OPENAI_API_KEY}
  model: gpt-realtime-translate   # or gpt-realtime (higher quality, higher cost)
  # isolate_turns: false          # gpt-realtime only. On by default: each turn is
                                  # translated with no history, so short questions
                                  # aren't answered (~0.5s slower)

session:
  source_lang: es
  target_lang: ja
  context: >
    Tourist in Japan for a honeymoon.
    Casual everyday conversations: restaurants, transport, shopping, hotels.
    Translate naturally, not literally. Prefer polite but friendly register.

adapter: device   # text | device | virtual-mic | media

voice: nova       # alloy | echo | fable | onyx | nova | shimmer

vad_threshold: 0.5      # 0.0–1.0, higher = less sensitive
vad_silence_ms: 600     # ms of silence before processing

# Silence gate: quiet audio isn't streamed, so it isn't billed. Each direction
# of a call is quiet most of the time. Off by default until measured on real
# calls; raise silence_gate_dbfs if a noisy room keeps it open.
silence_gate: false
silence_gate_dbfs: -50        # level below which a chunk counts as silence
silence_gate_hold_ms: 3000    # stay open this long after the last sound (under ~3s the ends of sentences arrive late)

# Your original voice under the translation the other side hears
# (headset, meet, virtual-mic). 0 = off, 0.15 is a good start.
passthrough: 0

device:
  mic: "USB PnP Audio Device"       # throat mic
  speaker: "USB Audio"              # outward speaker (Japanese person hears)
  earphone: "Headphones (Bone)"     # bone conduction (user hears)
  loopback: "CABLE-B Output"        # capture device for the other side's audio (bridge/meet IN)
  ptt_mode: vad                     # vad | hold | toggle

pair_mode:
  enabled: false
  role: primary                     # primary | secondary
  peer_address: "192.168.1.x:7373"

pricing:
  # The UI's cost meter. Rates default to core/pricing.py (OpenAI's published
  # prices as of 2026-07-25); set them here when a price changes.
  # per_minute: 0.034               # gpt-realtime-translate, PER DIRECTION
  # transcription_per_minute: 0.017 # gpt-realtime-whisper, input transcription
  count_transcription: true         # billed on top (measured 2026-10-21); keep it on
  budget: 20.00                     # USD; shows "$X left" in the footer

logging:
  save_session: true
  show_transcript: true
  session_dir: ~/.chasqui/sessions
